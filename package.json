{
  "name": "devkit",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "DevKit 码匠 —— 正经功能，欠揍文案的程序员本地工具集",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "codemirror": "^6.0.1",
    "cron-parser": "^4.9.0",
    "diff": "^5.2.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/diff": "^5.2.0",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.0.4",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.11"
  }
}
